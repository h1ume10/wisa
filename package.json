{
  "name": "wisa-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing site for Workplace Investigations South Africa (WISA).",
  "scripts": {
    "build:html": "node scripts/build-html.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build": "npm run build:html && npm run build:css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "watch:html": "node scripts/build-html.js --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "tailwindcss": "^3.4.13"
  }
}
